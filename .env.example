# ============================================================
# CLB IP ĐHSP Huế 2.0 — Biến môi trường MẪU
# Sao chép thành .env và điền giá trị cục bộ.
# KHÔNG bao giờ commit file .env thật hay khóa bí mật thật.
# ============================================================

# ---------- Django ----------
# settings.py fail-fast: DEBUG mặc định False; production BẮT BUỘC có
# SECRET_KEY riêng (không được bắt đầu bằng "django-insecure").
DEBUG=False
DJANGO_ENV=development
SECRET_KEY=thay-khoa-cua-ban-vao-day

# ---------- MySQL cục bộ (dev) ----------
DB_ENGINE=mysql
MYSQL_DATABASE=clb_ip_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ---------- Nhận diện IP sau proxy (production) ----------
# Render có 1 reverse proxy → IP client thật là phần tử CUỐI của
# X-Forwarded-For. Mặc định: NUM_PROXIES=1 khi DJANGO_ENV=production.
# Dev cục bộ KHÔNG có proxy → để trống/bỏ trống (throttle dùng REMOTE_ADDR).
# NUM_PROXIES=1

# ---------- File storage (production khuyến nghị S3/R2) ----------
# Đĩa Render là tạm thời — file upload mất khi restart. Đặt USE_S3=1 + AWS_*
# để lưu upload vào bucket (django-storages, đã có trong requirements).
# USE_S3=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=clbip-media
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto

# ---------- Cache dùng chung cho throttle/axes (production) ----------
# Ưu tiên Redis nếu có; không có thì dùng DatabaseCache (cần `createcachetable`)
# REDIS_URL=redis://default:pass@host:6379/0

# ---------- Seed demo (TUYỆT ĐỐI KHÔNG đặt trên production) ----------
# Chỉ build.sh đọc: seed chỉ chạy khi SEED_DEMO=1 VÀ DJANGO_ENV != production
# SEED_DEMO=1
# DEMO_PASSWORD=mat-khau-demo-cua-ban

# ---------- Domain khi deploy Render ----------
# ALLOWED_HOSTS=.onrender.com
# CORS_ALLOWED_ORIGINS=https://clbip-frontend.onrender.com
# MEDIA_ROOT_PERSISTENT=1  # tự khẳng định đã mount persistent disk vào MEDIA_ROOT (thay cho USE_S3)
# ALLOW_EPHEMERAL_UPLOADS=1  # CHỈ demo/pilot: chấp nhận mất upload khi restart (production + không S3 sẽ bị chặn nếu không có cờ này)

# ---------- Email (tính năng Quên Mật khẩu + OTP — TASK 2) ----------
# Dev: console backend (OTP in ra log Django, không cần SMTP thật).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: bật dòng dưới + điền SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@clbip.vn
