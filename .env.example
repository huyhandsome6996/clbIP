# ============================================================
# CLB IP ĐHSP Huế 2.0 — Cấu hình môi trường (.env)
# ============================================================
DEBUG=True
SECRET_KEY=django-insecure-clb-ip-dev-key-change-in-production

# Cấu hình MySQL Local (Mặc định cho hệ thống)
DB_ENGINE=mysql
MYSQL_DATABASE=clb_ip_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# URL chạy dev
BASE_URL=http://127.0.0.1:8000
